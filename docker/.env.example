# =============================================================================
# .env.example — modèle de configuration DHIS2 ALIMA
#
# Copier en .env et renseigner. LE FICHIER .env N'EST JAMAIS VERSIONNÉ.
#
# Sur les VM, ce fichier est généré depuis Secret Manager par le pipeline de
# déploiement — il n'est ni édité à la main ni conservé ailleurs.
#
# Chaque variable ci-dessous est consommée par docker/init.sh pour produire
# dhis.conf. Toute variable ajoutée à init.sh doit être reportée ici dans le
# même commit.
# =============================================================================

# --- Image à déployer --------------------------------------------------------
# Toujours un tag immuable, jamais "latest".
REGISTRY=europe-west1-docker.pkg.dev/alima-dhis2-prod/dhis2-images
IMAGE_TAG=2.41.9.1.20260814.01.556073b

# --- Base de données (OBLIGATOIRE) -------------------------------------------
# En production : IP privée de l'instance Cloud SQL.
DHIS2_DATABASE_HOST=10.10.0.3
DHIS2_DATABASE_PORT=5432
DHIS2_DATABASE_NAME=dhis2
DHIS2_DATABASE_USER=dhis                   # SECRET — via Secret Manager
DHIS2_DATABASE_PASSWORD=changeme           # SECRET — via Secret Manager
DHIS2_DB_WAIT_TIMEOUT=90

# --- Pool de connexions ------------------------------------------------------
DHIS2_CONNECTION_POOL_MAX_SIZE=40
DHIS2_CONNECTION_POOL_MAX_IDLE_TIME=7200000
DHIS2_CONNECTION_POOL_TIMEOUT=30000
DHIS2_CONNECTION_POOL_VALIDATION_TIMEOUT=5000
DHIS2_DB_POOL_TYPE=hikari

# --- Identité du serveur (OBLIGATOIRE) ---------------------------------------
DHIS2_FQDN=https://dhis2.alima.ngo
DHIS2_CONTEXT_PATH=/
DHIS2_SERVER_HTTPS=on

# --- Système -----------------------------------------------------------------
DHIS2_SYSTEM_READ_ONLY_MODE=off
DHIS2_SYSTEM_SESSION_TIMEOUT=3600
DHIS2_SQL_VIEW_TABLE_PROTECTION=on
DHIS2_SQL_VIEW_WRITE_ENABLED=off
DHIS2_SERVER_SIDE_PROGRAM_RULE_EXECUTION=on
DHIS2_SYSTEM_CACHE_MAX_SIZE_FACTOR=0.5
DHIS2_METADATA_SYNC_REMOTE_SERVERS=
DHIS2_SYSTEM_UPDATE_NOTIFICATIONS=on

# --- Chiffrement -------------------------------------------------------------
# SECRET — via Secret Manager. Ne JAMAIS changer après la mise en service :
# les données déjà chiffrées deviendraient illisibles.
DHIS2_ENCRYPTION_PASSWORD=

# --- SSO OpenID --------------------------------------------------------------
DHIS2_SSO_OPENID_ACTIVATED=false
DHIS2_SSO_OPENID_CLIENT_ID=
DHIS2_SSO_OPENID_CLIENT_SECRET=            # SECRET — via Secret Manager
DHIS2_SSO_OPENID_AUTHORIZATION_URI=
DHIS2_SSO_OPENID_TOKEN_URI=
DHIS2_SSO_OPENID_USERINFO_URI=
DHIS2_SSO_OPENID_JWK_URI=
DHIS2_SSO_OPENID_REDIRECT_URL=
DHIS2_SSO_OPENID_MAPPING_CLAIM=email

# --- Nœud / cluster ----------------------------------------------------------
# Laisser vide en instance unique.
DHIS2_NODE_ID=
DHIS2_NODE_PRIMARY_LEADER=false

# --- Supervision -------------------------------------------------------------
DHIS2_METRICS_ACTIVE=true
DHIS2_MONITORING_API=on
DHIS2_MONITORING_JVM=on
DHIS2_MONITORING_HIBERNATE=off
DHIS2_MONITORING_DBPOOL=on
DHIS2_MONITORING_UPTIME=on
DHIS2_MONITORING_CPU=on

# --- Redis -------------------------------------------------------------------
# Nécessaire uniquement en déploiement multi-instances.
DHIS2_REDIS_ENABLED=false
DHIS2_REDIS_HOST=localhost
DHIS2_REDIS_PORT=6379
DHIS2_REDIS_PASSWORD=
DHIS2_REDIS_USE_SSL=off

# --- Base analytique séparée -------------------------------------------------
DHIS2_ANALYTICS_DB_ACTIVATED=false
DHIS2_ANALYTICS_DB_URL=
DHIS2_ANALYTICS_DB_USERNAME=
DHIS2_ANALYTICS_DB_PASSWORD=
DHIS2_ANALYTICS_TABLE_UNLOGGED=on
DHIS2_ANALYTICS_POOL_MAX_SIZE=40

# --- Magasin de fichiers -----------------------------------------------------
# ALIMA reste sur "filesystem" : les fichiers vont dans le volume dhis2-files.
# Changer de fournisseur APRÈS la mise en service est complexe — les
# références en base doivent rester cohérentes. Décision à figer avant le
# Go-Live, pas après.
DHIS2_FILESTORE_PROVIDER=filesystem
DHIS2_FILESTORE_CONTAINER=
DHIS2_FILESTORE_LOCATION=
DHIS2_FILESTORE_ENDPOINT=
DHIS2_FILESTORE_IDENTITY=
DHIS2_FILESTORE_SECRET=

# --- Journalisation ----------------------------------------------------------
# Rotation explicite : la valeur par défaut de max_archives (0) n'offre
# aucune garantie de dimensionnement du volume dhis2-logs.
DHIS2_LOGGING_FILE_MAX_SIZE=100MB
DHIS2_LOGGING_FILE_MAX_ARCHIVES=5
DHIS2_LOGGING_QUERY=off
DHIS2_LOGGING_QUERY_SLOW_THRESHOLD=1000
DHIS2_LOGGING_SESSION_ID=on
DHIS2_LOGGING_LEVEL_DHIS=INFO
DHIS2_LOGGING_LEVEL_SPRING=WARN

# --- App Hub -----------------------------------------------------------------
DHIS2_APPHUB_BASE_URL=https://apps.dhis2.org
DHIS2_APPHUB_API_URL=https://apps.dhis2.org/api

# --- Sessions et API Route ---------------------------------------------------
DHIS2_MAX_SESSIONS_PER_USER=10
DHIS2_ROUTE_REMOTE_SERVERS_ALLOWED=

# --- JVM ---------------------------------------------------------------------
DHIS2_MAX_RAM_PERCENTAGE=80.0
DHIS2_EXTRA_JAVA_OPTS=

# --- Divers ------------------------------------------------------------------
TZ=UTC
DEBUG=false
# INSECURE=true force server.https=off — DÉVELOPPEMENT LOCAL UNIQUEMENT.
INSECURE=false

# --- TLS (Nginx) -------------------------------------------------------------
# Répertoire hôte contenant les certificats, monté en lecture seule.
TLS_CERT_DIR=/etc/letsencrypt

# --- Développement local uniquement ------------------------------------------
# Mot de passe du superutilisateur PostgreSQL du conteneur de base local.
POSTGRES_PASSWORD=postgres
