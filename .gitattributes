# =============================================================================
# .gitattributes — normalisation des fins de ligne
#
# TOUT ce dépôt s'exécute sous Linux : conteneurs Docker, VM Ubuntu, Cloud
# Build. Un fichier récupéré en CRLF depuis un poste Windows casse
# silencieusement l'exécution :
#
#   /usr/local/bin/init.sh: /bin/bash^M: bad interpreter: No such file or directory
#
# On force donc LF partout, dans le dépôt ET dans la copie de travail, quel
# que soit le réglage core.autocrlf du poste.
# =============================================================================

# Par défaut : détection automatique du texte, toujours stocké et restitué en LF
* text=auto eol=lf

# Fichiers exécutés dans les conteneurs ou sur la VM — LF impératif
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
*.xml       text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf

# Binaires : jamais convertis
*.png binary
*.jpg binary
*.gz  binary
*.pdf binary
